# ulsrcmap.extra -- the source of a shipped program that NOTHING COMPILES.
#
# ulsrcmap.py folds the build's own compile record into build/.ulsrcmap, one line
# per program.  A program that is never compiled leaves no record there and would
# be published with no source named, which makes the consuming repository refuse
# to cut the -src package the binary's licence obliges (os/dist/PACKAGE-FORMAT,
# `THE SOURCE MAP').  This file is where those are declared.
#
# Same format as the map: `<program> <source path>...', paths relative to os/, a
# path may be a file or a directory, `#' comments.  A path that does not exist is
# dropped, so a row cannot make the map name nothing.
#
# ONLY FOR PROGRAMS NOTHING COMPILES.  A row here is a hand statement that no
# build step backs, so every one of them needs a reason written beside it, and a
# program that IS compiled must never be given a row -- the compile record is
# then the truth and this would silently override nothing while going stale.
# A program copied byte-for-byte from another (gzip installed as gunzip and zcat,
# compress as uncompress) needs no row either: ulsrcmap.py matches those to the
# original by content.

# merge(1) -- RCS's three-way merge driver.  A shell script, and build-rcs.sh
# seds the installed paths of diff/diff3/co into it, so what ships is generated
# and its source is the .sh beside the rest of RCS.  The whole RCS directory
# travels because merge is one program of a package under one licence (GPLv1).
merge		tools/rcs

# wargames(6) -- a shell game, copied whole by build-games.sh.  The directory is
# the one games/bsd/scripts holds, which is this program and its siblings.
wargames	games/bsd/scripts

# mgr(1) -- the window server compiles a GENERATED icon table (build/mgr/gen/
# icon_server.c), which is build output and not source; what it is generated FROM
# is the server icon set, and what generates it is the host tool beside it.  The
# default font is baked in the same way.
mgr		mgr/src/tools mgr/icon/smallserver mgr/font/cmr-9x16

# /etc/inet, /etc/slip, /etc/ppp -- two of the stack's objects are ASSEMBLED,
# by net/Makefile and net/inet/Makefile calling as-z8001 directly rather than
# through the compile driver, so nothing records them.  rawsys.s is the raw
# system-call gate the channel layer needs; get_bp.s reads the caller's buffer
# pointer out of the syscall frame.
inet		net/inet/get_bp.s
slip		net/rawsys.s
ppp		net/rawsys.s
psipping	net/rawsys.s
