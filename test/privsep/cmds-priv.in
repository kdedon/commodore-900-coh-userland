# tests/privsep/cmds-priv.in -- the privilege pass, typed at a root shell.
# @MUTATE@ is replaced by run.sh: empty for the real system, and by a
# chmod that takes the four kernel-forced setuid bits off again for the mutant.
#
# Everything an ordinary user does here goes through `su guest', because su(1)
# run by root needs no password (cmd/su.c only prompts when getuid() is
# non-zero) and it setuid()s BOTH ids down.  That is what makes most of this
# answerable without a getty: the one thing it cannot produce is an /etc/utmp
# record, which is a separate phase.
#
# /usr holds the home directory and login(1)'s tty lock, so it must be
# mounted.  Results are written to /tmp on the ROOT filesystem, whose /tmp
# DIRECTORY is mode 777, and read back with fsread.py --part 136.
# The guest comes up MULTI-USER, so /etc/rc has mounted /usr already and a
# second mount of it answers "device busy".  What the check below needs is
# that /usr IS mounted, so mount it only when it is not, and report on the
# state rather than on the command.
/bin/test -d /usr/spool/uucp || /etc/mount /dev/hd6 /usr
/bin/test -d /usr/spool/uucp; echo PRIV mount rc=$?
mkdir /usr/guest; chown guest /usr/guest; chgrp user /usr/guest; echo PRIV home rc=$?
# A setuid-root program that reports its own ids.  There is no other way to see
# a real uid and an effective uid at the same time, which is the question #279
# (sudo) turns on.  /bin/factor is privids, injected over it.
cp /bin/factor /tmp/sfactor; chmod 4755 /tmp/sfactor; echo PRIV sfactor rc=$?
# The permission matrix, all owned by root.  Each name says its mode and, where
# it matters, that its group is `user' (gid 5) -- the group guest is in.
echo secret600 >/tmp/p600; chmod 600 /tmp/p600; chgrp system /tmp/p600
echo secret604 >/tmp/p604; chmod 604 /tmp/p604; chgrp system /tmp/p604
echo secret640g >/tmp/p640g; chmod 640 /tmp/p640g; chgrp user /tmp/p640g
echo secret604g >/tmp/p604g; chmod 604 /tmp/p604g; chgrp user /tmp/p604g
echo secret060 >/tmp/p060; chmod 060 /tmp/p060; chown guest /tmp/p060; chgrp system /tmp/p060
echo secret444 >/tmp/p444; chmod 444 /tmp/p444; chgrp system /tmp/p444
# The two directories phase 4 reads back out of the packed image are made under
# /privsep, on the ROOT filesystem: /tmp is a filesystem of its own on every
# media descriptor, and fsread.py reads one partition at a time.
mkdir /privsep; chmod 777 /privsep
@MUTATE@
/bin/factor ids
su guest /bin/factor ids
su guest /tmp/sfactor ids
su guest /bin/sh -c 'mkdir /privsep/keep'; echo PRIV keep rc=$?
su guest /bin/sh -c 'mkdir /privsep/gdir'; echo PRIV mkdir rc=$?
su guest /bin/sh -c 'mkdir /privsep/gdir/sub'; echo PRIV mkdirsub rc=$?
su guest /bin/sh -c 'mv /privsep/gdir/sub /privsep/gdir/moved'; echo PRIV mvdir rc=$?
su guest /bin/sh -c 'rm -r /privsep/gdir/moved'; echo PRIV rmr rc=$?
su guest /bin/sh -c 'rmdir /privsep/gdir'; echo PRIV rmdir rc=$?
# The three that need NO privilege, and are kept clear of the directories above
# so that a mutant run cannot fail them for the wrong reason: creating,
# renaming and unlinking a REGULAR file in a mode-777 directory is something
# any user may do, and a gate that expected these to break with the setuid bits
# off would be asserting something untrue.
su guest /bin/sh -c 'echo inner >/tmp/ginner'; echo PRIV innerfile rc=$?
su guest /bin/sh -c 'echo x >/tmp/gfile; mv /tmp/gfile /tmp/gfile2'; echo PRIV mvfile rc=$?
su guest /bin/sh -c 'rm /tmp/gfile2'; echo PRIV rmfile rc=$?
# Two refusals that need no setuid bit at all: rmdir -f and chgrp both test the
# caller's id themselves, and both have only ever been run by root.
su guest /bin/sh -c 'rmdir -f /tmp/nosuch'; echo PRIV rmdirf rc=$?
su guest /bin/chgrp system /tmp/p604; echo PRIV chgrp rc=$?
# imode(): the owner, group and other arms, in both directions.
su guest /bin/factor read /tmp/p600; echo PRIV r600 rc=$?
su guest /bin/factor read /tmp/p604; echo PRIV r604 rc=$?
su guest /bin/factor read /tmp/p640g; echo PRIV r640g rc=$?
su guest /bin/factor read /tmp/p604g; echo PRIV r604g rc=$?
su guest /bin/factor read /tmp/p060; echo PRIV r060 rc=$?
su guest /bin/factor write /tmp/p444; echo PRIV w444 rc=$?
# access(2) is answered for the REAL ids and open(2) for the effective ones, so
# a setuid-root program gets opposite answers from the two about one file.
su guest /bin/factor access /tmp/p600; echo PRIV a600 rc=$?
su guest /tmp/sfactor access /tmp/p600; echo PRIV sa600 rc=$?
su guest /tmp/sfactor read /tmp/p600; echo PRIV sr600 rc=$?
# passwd(1) is setuid root and decides what the caller may do from getuid(),
# the real one.  Refusing to change root's password is that decision.
su guest /bin/passwd root; echo PRIV passwdroot rc=$?
# newgrp execs a shell, so its answer is fed to that shell on a pipe.
echo '/bin/factor ids' | su guest /bin/newgrp system; echo PRIV ngsystem rc=$?
echo '/bin/factor ids' | su guest /bin/newgrp user; echo PRIV nguser rc=$?
echo '/bin/factor ids' | su guest /bin/newgrp nosuchgroup; echo PRIV ngnone rc=$?
