# Address + default route on the ip interface, through the inet daemon's
# control channel, then read the address back out of the daemon.  A setting
# ioctl returning 0 only says the request was accepted; the read-back is what
# proves ip_port holds the address.  Single user, so results go to the root
# filesystem.
/etc/mknod /dev/inet p
/etc/inet &
sleep 3
/etc/ifconfig 10.0.0.2 255.255.255.0 10.0.0.1
echo IFCRC=$?
/etc/ifconfig
echo SHOWRC=$?
ps
