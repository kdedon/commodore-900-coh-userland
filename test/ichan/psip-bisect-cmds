# Bisect the daemon's inbound psip path.  Each kind gets further in than the
# last -- runt is rejected on length, badsum on the header checksum, proto has a
# valid header but a protocol nothing handles, echo is the real thing -- so the
# first kind that misbehaves names the stage that is broken.
/etc/mknod /dev/inet p
/etc/inet &
sleep 3
/etc/ifconfig 10.0.0.2 255.255.255.0
/bin/psipping 1 runt
echo RUNT=$?
/bin/psipping 1 badsum
echo BADSUM=$?
/bin/psipping 1 proto
echo PROTO=$?
ps
