# cpm.list -- CP/M-8000 interchange: the cpm(1) utility moving files between
# the Coherent FS and the raw drive A: partition (/dev/cpma), dos(1)-style.
# Only dists carrying the cpma partition (media/hd42-cpm.media) include this.
# PACKAGE.  The CP/M-8000 guest side: one program and its device, additive
# to any system that has the partition for it.
package  cpm
role     optional
# KINDS -- see os/dist/PACKAGE-FORMAT.  `bin' is the list below; `src' is the
# complete corresponding source for every executable it installs, and refuses
# to be cut from a guess; `man' is the Lexicon article for cpm(1), claimed by
# the program's own name in man.index.
kinds    src man

f	/bin/cpm
