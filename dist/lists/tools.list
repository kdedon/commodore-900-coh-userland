# tools.list -- the general-purpose tools the 3.2 userland never had: a
# full-screen pager, a compressor, a patch applier and a revision control
# system.  None of them is MWC code; all four are period third-party ports that
# shipped for COHERENT (less 177, gzip 0.8.2, patch 2.0.1, RCS 4.3).
#
# EVERYTHING HERE LIVES IN /usr/bin, beside more(1) and elvis(1), which is
# where a general-purpose tool belongs.  Nothing in this list is on the root
# filesystem.
#
# The two reasons that could justify moving one of these to /bin, and why
# neither applies:
#
#   Space.  /usr is sized in dist/media/*.media, and the partition table is
#   generated from those files into kboot.cfg (hostbuild/dist.py wdslots), so
#   growing it is one edit.  On the 21 MB media /usr and /usr/man jointly own blocks
#   10336..31007 and the boundary between them sits where it does because man
#   is read-only and sized to its content, leaving the growth room on the /usr
#   side; the 42 MB development media gives /usr the whole tail of the drive.
#   Move a boundary rather than scatter commands across filesystems.
#
# TO BE CLEAR ABOUT WHAT IS *NOT* A REASON HERE: single-user reachability.
# /usr is a separate filesystem that only /etc/rc mounts, so none of the
# /usr/bin entries exist in the single-user maintenance shell -- and that is
# NORMAL, not a defect.  A root filesystem carrying only the basics, with ed(1)
# as the editor and no pager, is how Unix is supposed to look in single user.
# Do not move a command here to make single user more capable, and do not put
# its data files on the root filesystem for that reason either; help text
# belongs in /usr/lib beside more.help.
#
# Check the `mkimage' block counts before adding to either side.

# --- /usr/bin: the pager, the patch applier and the revision control system --
# less 177 (os/cmd/less).  Termcap-driven, so it needs /etc/termcap and the
# $TERM that base.list's /.profile sets.
# less.hlp is the text `h' displays, read at run time from the path baked into
# cmd/less/defines.h, in /usr/lib where command data files belong beside
# more.help.
# PACKAGE (os/dist/PACKAGE-FORMAT).  A list with a `package' line is an
# addressable unit of a release channel; one without is not, and that is how
# testing.list stays out of one.
package  tools
role     optional
# KINDS -- the packages this component publishes besides its runtime half.
# `bin' is the list below and is not written down; `src' is the complete
# corresponding source for every executable it installs, and `man' is the pages
# for those programs.  os/dist/PACKAGE-FORMAT argues both, and neither can be
# cut from a guess: -src refuses without the producer's source map, -man refuses
# when not one of these programs has a page.
kinds    src man

f	/usr/bin/less
f	/usr/bin/lesskey
f	/usr/lib/less.hlp

# gzip 0.8.2 (os/cmd/gzip), under three names.
#
# gzip opens its output O_CREAT|O_EXCL, so it depends on the kernel clearing
# its in-core exclusive-open mark at close (sys/coh/fs3.c iclose(), covered
# by tests/openexcl); a kernel that does not refuses every later open of the
# archive with EEXIST until the inode is evicted.
#
#   THE THIRD NAME MUST BE gzcat, NOT zcat: base.list already stages /bin/zcat
#   (a copy of compress(1), LZW only), and gzip.c:351 already recognises
#   "gzcat".  A duplicate destination is a hard error in the packer, so the
#   name has to differ even though the directories now do.
f	/usr/bin/gzip
f	/usr/bin/gunzip	src=hostbuild/build/bin/gzip
f	/usr/bin/gzcat	src=hostbuild/build/bin/gzip

# patch 2.0.1 (os/cmd/patch).  The 2.0.1 kit rather than the Coherent-adapted
# 2.0 one: 2.0 predates unified diff entirely (no UNI_DIFF anywhere in it), and
# a patch that cannot read `diff -u' output is not useful now.  Context, unified
# and normal formats all apply.
#
# This system's own diff(1) feeds it: diff's default output is the normal
# format (`3a4', `4d3', `1,2c1,2', base/cmd/diff/diff2.c), which patch reads
# and applies.  diff has no context or unified output (`diff [-bdefhs]
# [-c symbol]' -- its -c takes a SYMBOL, for #ifdef output), so patches made
# here are normal-format ones; patch also applies context and unified patches
# brought in from elsewhere.
f	/usr/bin/patch

# --- /usr/bin: the developer toolset ----------------------------------------
# RCS 4.3 (os/cmd/rcs).  ci/co/rcs/rcsclean exec each other and diff(1) by the
# absolute paths compiled into them (build-rcs.sh: CO, RCS_CMD and MERGE point
# at /usr/bin, DIFF and DIFF3 at /bin), so these paths are load-bearing --
# moving any of them breaks the delta and merge paths silently.  merge is a
# shell script, not a binary.
f	/usr/bin/ci
f	/usr/bin/co
f	/usr/bin/rcs
f	/usr/bin/rlog
f	/usr/bin/ident
f	/usr/bin/rcsdiff
f	/usr/bin/rcsclean
f	/usr/bin/rcsmerge
f	/usr/bin/merge
