# install.list -- the content of the installation floppy (dist/media/fdinstall.media).
#
# This is COHERENT distribution volume 1, restored.  The C900 original survives
# as ~/git/C900/firmware/floppy_extracted: a bootable Coherent filesystem whose
# root held the kernel, a /bin cut down to what an installer needs, and a /kit
# of prototype files and shell scripts.  The user booted it, typed `build', and
# `build' laid a filesystem onto the hard disk.  The list below is that volume,
# with this port's names for things.
#
# IT DOES NOT INCLUDE base.list, on purpose.  Everything here has to fit in 2392
# blocks alongside a 100 KB kernel, so the set is chosen rather than inherited:
# adding a command to the shipping system must not silently push this medium
# over its capacity, and a fragment that composed base.list would do exactly
# that.  The cost is that a command wanted in both places is named twice.

# NOT A PACKAGE (os/dist/PACKAGE-FORMAT: a list without a `package' line is
# not one).  This is the content of a floppy medium, not a component a release
# channel installs onto a machine: the release ships hard-drive images and
# component install sets, and every program below is packaged by the
# component that owns it.

# --- directory skeleton -----------------------------------------------------

d	/bin
d	/dev
d	/drv
d	/etc
d	/kit
# The mount point the installer builds the new root filesystem on, and the
# scratch directory the tools want.
d	/mnt
d	/tmp	777 0 1

# --- system ------------------------------------------------------------------
# init spawns a getty on every line /etc/ttys enables; getty execs login.  The
# console driver is a runtime choice (vidsel probes and names one), so all three
# ship: an install floppy is precisely the medium that does not know what
# machine it is going into.
f	/etc/init
f	/etc/getty
f	/bin/login	4755 0 1
# login locks the terminal it is about to hand over by creating an LCK.. file
# in /usr/spool/uucp (base/cmd/login/lock.c).  This medium mounts no /usr, so
# the directory is part of its own root filesystem; without it login prints
# "cannot lock terminal" and the floppy reaches no shell and no installer.
d	/usr
d	/usr/spool
d	/usr/spool/uucp
f	/etc/load
f	/etc/ttys
f	/etc/passwd
f	/etc/group
f	/etc/termcap
f	/.profile
e	/etc/mnttab	644 0 1
e	/etc/utmp	666 0 1
include	lists/console-both.list

# /etc/rc for this medium only: it mounts nothing, because the root filesystem
# is the floppy and there is nothing else to mount until the installer has made
# it.  The shipping rc (dist/files/etc/rc.in) would be substituted with an empty
# @MOUNTS@ and come to the same thing, but an install medium saying so itself is
# worth more than a template that happens to expand to nothing.
f	/etc/rc		755 0 1	src=dist/files/install/rc

# --- the installer -----------------------------------------------------------
# build(1) is the whole procedure.
# /kit holds no listed content.  Everything in it is GENERATED by mkimage.py
# from the target media descriptor: the loader config that drive will boot on,
# and one mkfs prototype per filesystem the installer has to make.  Both state
# the disk layout, and the media descriptor is the only place that does.
f	/bin/build	755 0 1	src=dist/files/install/build
# The second stage, which build(1) installs onto the target as its /.profile:
# the later volumes can only be read once the hard disk is root and the one
# drive is free.  It is /kit content, so cpdir never copies it onto the
# installed system by accident.
f	/kit/cpsys	755 0 1	src=dist/files/install/cpsys

# --- the tools build(1) uses -------------------------------------------------
f	/etc/mkproto
f	/etc/mkfs
f	/etc/mknod
f	/etc/mount
f	/etc/umount
f	/etc/clri
f	/bin/badscan
f	/bin/cpdir
f	/bin/sync
f	/bin/dd

# --- enough of a shell to work in --------------------------------------------
f	/bin/sh
f	/bin/cat
f	/bin/chgrp
f	/bin/chmod
f	/bin/chown
f	/bin/cmp
f	/bin/cp
f	/bin/date
f	/bin/df
f	/bin/du
f	/bin/echo
f	/bin/ed
f	/bin/grep
f	/bin/kill
f	/bin/ln
f	/bin/ls
# mkdir, mv, rm and rmdir are setuid root, the same bits base.list gives them and
# for the same kernel reason (see the comment there).  The installer itself runs as
# root and would not notice, but a mode is a property of the PROGRAM: these are the
# copies the rescue user gets when this floppy is booted to repair a disk, and a
# program that is privileged on one image and not another is the defect.
f	/bin/mkdir	4755 0 1
f	/bin/mv		4755 0 1
f	/bin/od
# ps is setuid root for the same property reason: /dev/kmem, /dev/mem and
# /dev/swap are 600 root on this medium's device table too, so without the bit
# the rescue user's ps cannot open any of the three.
f	/bin/ps		4755 0 1
f	/bin/pwd
f	/bin/rm		4755 0 1
f	/bin/rmdir	4755 0 1
f	/bin/sleep
f	/bin/stty
f	/bin/test
f	/bin/tty
# The filesystem checkers, so a floppy boot is also a rescue boot: this is the
# only medium that can look at a hard-disk root that will not mount.
f	/bin/icheck
f	/bin/dcheck
f	/bin/ncheck
