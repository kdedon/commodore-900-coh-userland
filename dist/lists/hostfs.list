# hostfs.list -- the host-directory pass-through disk.
#
# A development interface.  The driver is a block device whose controller is
# a 38-byte mailbox that a host program serves, so an installed copy reaches
# a directory on the host.  With nothing on the host answering the mailbox the
# driver's open fails ENXIO and nothing else is reachable.
#
# The distribution repository's coherent3-dev includes this list; it is also
# cut as the optional c900-hostfs packages whatever a dist includes.
#
# The /dev nodes (block /dev/hfs + char /dev/rhfs, major 11 minor 0) are NOT
# listed here because device tables are per-dist (.devices files) and the
# shipped one must not change; hostfs(1) creates both nodes on first use.
#
# /drv/hostfs is the kernel repository's, linked against its kernel by that
# repository's build-drivers.sh into hostbuild/build/drv.  /bin/hostfs is this
# repository's, base/cmd/hostfs/hostfs.c built into hostbuild/build/bin.  Each
# names its file with src=, so neither of the two programs called hostfs is
# chosen by a search.
#
# Under the emulator a host directory needs none of this: it is a filesystem
# image on the stock /dev/fd1 floppy, written and read back on the host.
# PACKAGE.  The host filesystem driver and its client, additive and
# development-only in practice, but nothing about it is exclusive.
package  hostfs
role     optional
# KINDS -- see os/dist/PACKAGE-FORMAT.  `bin' is the list below; `src' is the
# complete corresponding source for every executable it installs, and refuses
# to be cut from a guess.  No `man': neither the driver nor its client has a
# page, so both ship undocumented, which os/dist/coverage.tab records.
kinds    src

f	/drv/hostfs	755 0 1	src=hostbuild/build/drv/hostfs
f	/bin/hostfs	755 3 1	src=hostbuild/build/bin/hostfs
