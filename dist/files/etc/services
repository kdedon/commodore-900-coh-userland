#
# services -- well-known port numbers, in the traditional format:
#
#	name		port/protocol	[aliases...]
#
# Read by getservbyname()/getservbyport() (os/net/netdb.c).  There is no
# resolver and no NIS here; this file is the whole database.
#
# libsocket carries a small built-in copy of the entries below, so a machine
# whose /etc/services was never installed can still reach the well-known ports.
# The file wins where both have an entry, which is how a site changes one.
#
echo		7/tcp
echo		7/udp
discard		9/tcp		sink null
discard		9/udp		sink null
systat		11/tcp		users
daytime		13/tcp
daytime		13/udp
netstat		15/tcp
chargen		19/tcp		ttytst source
ftp-data	20/tcp
ftp		21/tcp
telnet		23/tcp
smtp		25/tcp		mail
time		37/tcp		timserver
time		37/udp		timserver
whois		43/tcp		nicname
#
# ntp is what /etc/sntp asks for, and it is not the same service as `time'
# above.  RFC 868 time is a bare 32-bit count of seconds since 1900 with no
# accuracy statement and no way to tell a synchronised server from one guessing;
# ntp (RFC 4330) carries a stratum, a leap indicator and four timestamps, which
# is what makes a reply checkable.  Nothing here speaks RFC 868, so `time' is
# listed for completeness and `ntp' is the one that is used.
ntp		123/udp
domain		53/tcp		nameserver
domain		53/udp		nameserver
tftp		69/udp
finger		79/tcp
#
# UNIX-specific services.
#
exec		512/tcp
biff		512/udp		comsat
login		513/tcp
who		513/udp		whod
shell		514/tcp		cmd
syslog		514/udp
printer		515/tcp		spooler
talk		517/udp
ntalk		518/udp
route		520/udp		router routed
#
# Games.  hunt(6) looks its ports up by name before it will start, and will
# not find them anywhere else.
#
hunt		26740/udp
hunt-back	26741/udp
mazewar		26742/udp
