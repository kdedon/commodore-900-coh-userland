/* dumper.c -- host tool: run the original adventure database scan (rdata),
 * then emit (a) adventure.msg = the post-scan message image, and (b)
 * tables.c = every table the scan built, with seekadr as FILE OFFSETS. */
#include <stdio.h>
#include <string.h>
#include "hdr.h"
#include "extern.h"

/* setup's encryption of glorkz, ending in the 0 setup appends */
#include "data.c"
static int data_size = sizeof data_file - 1;

static long off(struct text *t) { return t->seekadr ? (long)(t->seekadr - data_file) : -1L; }

static void dump_text(FILE *f, const char *name, struct text *t, int n)
{
	int i;
	fprintf(f, "struct text %s[%d] = {\n", name, n);
	for (i = 0; i < n; i++)
		fprintf(f, "\t{%ldL,%d},\n", off(&t[i]), t[i].txtlen);
	fprintf(f, "};\n");
}

int main(void)
{
	FILE *f;
	int i, j, n;

	rdata();

	f = fopen("adventure.msg", "wb");
	fwrite(data_file, 1, data_size, f);
	fclose(f);

	f = fopen("tables.c", "w");
	fprintf(f, "/* GENERATED by dumper.c from glorkz -- do not edit.\n");
	fprintf(f, " * The original scan (io.c rdata) ran on the HOST; these are its\n");
	fprintf(f, " * results with seekadr as adventure.msg file offsets (-1 = none). */\n");
	fprintf(f, "#include \"hdr.h\"\n\n");
	dump_text(f, "ltext", ltext, LOCSIZ);
	dump_text(f, "stext", stext, LOCSIZ);
	dump_text(f, "ptext", ptext, 101);
	dump_text(f, "rtext", rtext, RTXSIZ);
	dump_text(f, "ctext", ctext, CLSMAX);
	dump_text(f, "mtext", mtext, MAGSIZ);

	fprintf(f, "short trvflat[] = {\n");
	for (i = 0; i < LOCSIZ; i++) {
		struct travlist *t;
		for (n = 0, t = travel[i]; t; t = t->next) n++;
		if (!n) continue;
		fprintf(f, "\t%d,%d,", i, n);
		for (t = travel[i]; t; t = t->next)
			fprintf(f, "%d,%d,%d,", t->tverb, t->tloc, t->conditions);
		fprintf(f, "\n");
	}
	fprintf(f, "\t-1 };\n");

	/* struct vocent comes from hdr.h */
	fprintf(f, "struct vocent vocflat[] = {\n");
	for (i = 0; i < HTSIZE; i++)
		if (voc[i].atab) {
			char *w = voc[i].atab;
			/* the stored image is XOR-'=' encoded INCLUDING the
			 * terminator (0 ^ '=' == 0x3D); emit the exact bytes
			 * (a mid-word 0x3D is impossible: c^'='=='=' iff c==0) */
			fprintf(f, "\t{%d,%d,\"", i, voc[i].val);
			for (j = 0; ; j++) {
				fprintf(f, "\\%03o", w[j] & 0xFF);
				if ((w[j] & 0xFF) == 0x3D)
					break;
			}
			fprintf(f, "\"},\n");
		}
	fprintf(f, "\t{-1,0,\"\"} };\n");

#define DINT(a, n) do { fprintf(f, "int %s[%d] = {", #a, n); \
	for (j = 0; j < n; j++) fprintf(f, "%d,", a[j]); fprintf(f, "};\n"); } while (0)
	DINT(plac, 101); DINT(fixd, 101); DINT(actspk, 35);
	DINT(cond, LOCSIZ); DINT(cval, CLSMAX);
	fprintf(f, "int hints[20][5] = {\n");
	for (i = 0; i < 20; i++) {
		fprintf(f, "\t{");
		for (j = 0; j < 5; j++) fprintf(f, "%d,", hints[i][j]);
		fprintf(f, "},\n");
	}
	fprintf(f, "};\n");
	fprintf(f, "int hntmax = %d;\nint clsses = %d;\n", hntmax, clsses);
	fclose(f);
	fprintf(stderr, "dumper: adventure.msg (%d B) + tables.c written\n",
		data_size);
	return 0;
}
