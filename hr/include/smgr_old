#define SM_WHOFRONT     (4) /* is a window frontmost        */
#define SM_ACTIVATE     (5) /* make a window active         */
#define SM_WHOACTIVE    (6) /* is a window active           */
#define SM_DEACTIVATE   (7) /* deactivate a window          */
